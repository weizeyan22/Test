Step1 Status = 
VAR CurrentRole = 'BR'[RoleDisplayName]
VAR CurrentApp = 'BR'[ApplicationName]
VAR CurrentEntitlement = 'BR'[EntitlementName]
VAR CurrentStep = 'BR'[Step2]

-- Vérifier s'il existe au moins une ligne avec Completion Date vide
VAR HasEmptyCompletionDate =
    CALCULATE(
        COUNTROWS('BR'),
        'BR'[RoleDisplayName] = CurrentRole &&
        'BR'[ApplicationName] = CurrentApp &&
        'BR'[EntitlementName] = CurrentEntitlement &&
        'BR'[Step2] = "1st Step - Business Role Owner" &&
        ISBLANK('BR'[ArchivedDate])
    ) > 0

-- Si toutes les Completion Dates sont remplies, prendre la plus récente
VAR LatestCompletionDate =
    IF(
        NOT HasEmptyCompletionDate,
        CALCULATE(
            MAX('BR'[ArchivedDate]),
            'BR'[RoleDisplayName] = CurrentRole &&
            'BR'[ApplicationName] = CurrentApp &&
            'BR'[EntitlementName] = CurrentEntitlement &&
            'BR'[Step2] = "1st Step - Business Role Owner"
        )
    )

-- Si une Completion Date est vide, prendre la ligne avec la Creation Date la plus récente
VAR LatestCreationDate =
    IF(
        HasEmptyCompletionDate,
        CALCULATE(
            MAX('BR'[CreationDate]),
            'BR'[RoleDisplayName] = CurrentRole &&
            'BR'[ApplicationName] = CurrentApp &&
            'BR'[EntitlementName] = CurrentEntitlement &&
            'BR'[Step2] = "1st Step - Business Role Owner" &&
            ISBLANK('BR'[ArchivedDate])
        )
    )

-- Trouver la décision associée à la bonne date
VAR SelectedDecision =
    CALCULATE(
        MAX('BR'[Decision.1]),
        'BR'[RoleDisplayName] = CurrentRole &&
        'BR'[ApplicationName] = CurrentApp &&
        'BR'[EntitlementName] = CurrentEntitlement &&
        'BR'[Step2] = "1st Step - Business Role Owner" &&
        (
            ('BR'[ArchivedDate] = LatestCompletionDate && NOT HasEmptyCompletionDate) || 
            ('BR'[CreationDate] = LatestCreationDate && HasEmptyCompletionDate)
        )
    )

RETURN SelectedDecision
