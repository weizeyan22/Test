Criticality = 
VAR CountMyIAM = 
    CALCULATE(
        DISTINCTCOUNT('VotreTable'[MyIAM ent]), 
        ALLEXCEPT('VotreTable', 'VotreTable'[IT Role], 'VotreTable'[Group])
    )

VAR CountGroup = 
    CALCULATE(
        DISTINCTCOUNT('VotreTable'[Group]), 
        ALLEXCEPT('VotreTable', 'VotreTable'[MyIAM ent], 'VotreTable'[IT Role])
    )

RETURN 
    IF(CountMyIAM = 1 && CountGroup = 1, "1-1",
        IF(CountMyIAM = 1 && CountGroup > 1, "1-N",
            IF(CountMyIAM > 1 && CountGroup = 1, "N-1",
                "Autre Cas"
            )
        )
    )
