Groups Concatenated = 
CALCULATE(
    CONCATENATEX(
        VALUES('VotreTable'[Group]), 
        'VotreTable'[Group], 
        ", ", 
        'VotreTable'[Group], 
        ASC
    ),
    ALLEXCEPT('VotreTable', 'VotreTable'[MyIAM ent], 'VotreTable'[IT Role])
)



Latest WorkItem Owner Members = 
VAR LatestOwner =
    'Table'[Last WorkItem Owner]  -- Récupérer le dernier propriétaire
RETURN
    CONCATENATEX(
        FILTER(        FILTER(
            'Workgroup Members Table', 
            'Workgroup Members Table'[WorkItem Owner] = LatestOwner
        ), 
        'Workgroup Members Table'[Member Name], 
        UNICHAR(10)  -- Séparateur de ligne
    )


Latest WorkItem Owner Members = 
VAR LatestOwner = 'Table'[Last WorkItem Owner]
VAR FilteredTable = FILTER('Table', 'Table'[WorkItem Owner] = LatestOwner)
RETURN 
    IF(
        ISBLANK(LatestOwner), 
        BLANK(), 
        CONCATENATEX(FilteredTable, 'Table'[WorkItem Owner Members], UNICHAR(10))
    )


Latest WorkItem Owner Members =
VAR LatestCompletionDate = 'Table'[Latest Completion Date]
VAR LatestOwner = 'Table'[Last WorkItem Owner]
VAR FilteredTable = 
    SUMMARIZE(
        FILTER('Table', 'Table'[WorkItem Owner] = LatestOwner && 'Table'[Completion Date] = LatestCompletionDate),
        'Table'[WorkItem Owner Members]
    )
RETURN 
    CONCATENATEX(FilteredTable, 'Table'[WorkItem Owner Members], UNICHAR(10))




