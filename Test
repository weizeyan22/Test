Last WorkItem Owner = 
VAR LatestDate = 
    CALCULATE(
        MAX('Table'[Completion Date]),
        FILTER(
            'Table',
            'Table'[Role] = EARLIER('Table'[Role]) &&
            'Table'[App] = EARLIER('Table'[App]) &&
            'Table'[Ent] = EARLIER('Table'[Ent])
        )
    )
VAR LastOwner = 
    CALCULATE(
        MAX('Table'[WorkItem Owner]),
        FILTER(
            'Table',
            'Table'[Role] = EARLIER('Table'[Role]) &&
            'Table'[App] = EARLIER('Table'[App]) &&
            'Table'[Ent] = EARLIER('Table'[Ent]) &&
            'Table'[Completion Date] = LatestDate
        )
    )
RETURN LastOwner
