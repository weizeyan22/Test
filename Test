Cardinality = 
VAR CountMyIAM = 
    CALCULATE(
        DISTINCTCOUNT('VotreTable'[MyIAM Ent]), 
        ALLEXCEPT('VotreTable', 'VotreTable'[IT Role Ent]),
        NOT(ISBLANK('VotreTable'[IT Role Ent])) -- Exclure les valeurs vides
    )

VAR CountITRole = 
    CALCULATE(
        DISTINCTCOUNT('VotreTable'[IT Role Ent]), 
        ALLEXCEPT('VotreTable', 'VotreTable'[MyIAM Ent]),
        NOT(ISBLANK('VotreTable'[IT Role Ent])) -- Exclure les valeurs vides
    )

RETURN 
    IF(CountMyIAM = 1 && CountITRole = 1, "1-1",
        IF(CountMyIAM = 1 && CountITRole > 1, "1-N",
            IF(CountMyIAM > 1 && CountITRole = 1, "N-1",
                "Autre Cas"
            )
        )
    )
