Total Ongoing =
VAR LatestCreationDate =
    CALCULATE(
        MAX('BR'[Creation Date]),
        FILTER(
            'BR',
            'BR'[Role] = EARLIER('BR'[Role]) 
        )
    )

VAR LatestCompletionDate =
    CALCULATE(
        MAX('BR'[Completion Date]),
        FILTER(
            'BR',
            'BR'[Role] = EARLIER('BR'[Role]) &&
            'BR'[Creation Date] = LatestCreationDate
        )
    )

VAR IsLatestStep =
    'BR'[Creation Date] = LatestCreationDate &&
    (ISBLANK(LatestCompletionDate) || 'BR'[Completion Date] = LatestCompletionDate)

VAR TotalOngoingCount =
    CALCULATE(
        DISTINCTCOUNT( 'BR'[App_Ent_WorkItemID] ),
        FILTER(
            'BR',
            'BR'[Role] = EARLIER('BR'[Role]) &&
            'BR'[Decision.1] = "Undecided"
        )
    )

RETURN 
    IF(IsLatestStep, TotalOngoingCount, BLANK())
