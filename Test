IsLatestDate = 
VAR LatestCreationDate =
    CALCULATE(
        MAX('BR'[Creation Date]),
        FILTER(
            'BR',
            'BR'[Role] = EARLIER('BR'[Role]) &&
            'BR'[Application] = EARLIER('BR'[Application]) &&
            'BR'[Entitlement] = EARLIER('BR'[Entitlement]) &&
            'BR'[Operation] = EARLIER('BR'[Operation]) &&
            'BR'[Action] = EARLIER('BR'[Action])
        )
    )

VAR LatestCompletionDate =
    CALCULATE(
        MAX('BR'[Completion Date]),
        FILTER(
            'BR',
            'BR'[Role] = EARLIER('BR'[Role]) &&
            'BR'[Application] = EARLIER('BR'[Application]) &&
            'BR'[Entitlement] = EARLIER('BR'[Entitlement]) &&
            'BR'[Operation] = EARLIER('BR'[Operation]) &&
            'BR'[Action] = EARLIER('BR'[Action]) &&
            'BR'[Creation Date] = LatestCreationDate
        )
    )

RETURN 
IF('BR'[Completion Date] = LatestCompletionDate, "Yes", "No")
