Step2_AdjustedStatus = 
VAR Step1Date = 
    CALCULATE(
        MAX('BR'[ArchivedDate]),
        FILTER('BR', 
            'BR'[RoleDisplayName] = EARLIER('BR'[RoleDisplayName]) &&
            'BR'[ApplicationName] = EARLIER('BR'[ApplicationName]) &&
            'BR'[EntitlementName] = EARLIER('BR'[EntitlementName]) &&
            'BR'[Step] = "Step1" &&
            'BR'[Operation] = EARLIER('BR'[Operation])
        )
    )

VAR Step2Date = 'BR'[ArchivedDate]

RETURN 
    IF(Step1Date > Step2Date, BLANK(), 'BR'[Status])
