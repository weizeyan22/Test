FiltreWorkItemsMesure = 
VAR SelectedUser = SELECTEDVALUE('Users'[UserID])  -- Slicer pour sélectionner l'utilisateur
VAR IsOwner = 
    CALCULATE(
        COUNTROWS('BR'),
        'BR'[WorkItem Owner UID] = SelectedUser
    )
VAR IsMember = 
    CALCULATE(
        COUNTROWS('BR'),
        'BR'[WorkItem Owner Member UID] = SelectedUser
    )
RETURN
    IF(IsOwner > 0 || IsMember > 0, 1, 0)
