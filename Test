Step1 Status = 
VAR LatestCreationDateStep1 = 
    CALCULATE(
        MAX('BR'[Creation Date]), 
        FILTER(
            'BR', 
            'BR'[Role] = EARLIER('BR'[Role]) && 
            'BR'[Entitlement] = EARLIER('BR'[Entitlement]) && 
            'BR'[Step] = "Step 1"
        )
    )
VAR LatestCompletionDateStep1 = 
    CALCULATE(
        MAX('BR'[Completion Date]), 
        FILTER(
            'BR', 
            'BR'[Role] = EARLIER('BR'[Role]) && 
            'BR'[Entitlement] = EARLIER('BR'[Entitlement]) && 
            'BR'[Step] = "Step 1" &&
            'BR'[Creation Date] = LatestCreationDateStep1
        )
    )
VAR FinalDate = 
    IF(
        ISBLANK(LatestCompletionDateStep1),
        LatestCreationDateStep1,
        LatestCompletionDateStep1
    )
VAR Step1Status = 
    CALCULATE(
        MAX('BR'[Status]), 
        FILTER(
            'BR', 
            'BR'[Role] = EARLIER('BR'[Role]) && 
            'BR'[Entitlement] = EARLIER('BR'[Entitlement]) && 
            'BR'[Step] = "Step 1" && 
            'BR'[Creation Date] = LatestCreationDateStep1 && 
            'BR'[Completion Date] = LatestCompletionDateStep1
        )
    )
RETURN 
    Step1Status
