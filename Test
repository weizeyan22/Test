IsVisible = 
VAR SelectedUser = SELECTEDVALUE('BR'[WorkItem Owner Member]) -- Utilisateur sélectionné dans le filtre  
VAR LatestOwner = 'BR'[Latest WorkItem Owner] 
VAR AllMembers = 'BR'[All Members]  

RETURN 
IF(
    -- Cas 1: L'utilisateur est directement Latest WorkItem Owner
    LatestOwner = SelectedUser 

    -- Cas 2: L'utilisateur appartient à un Workgroup (présent dans All Members)
    || CONTAINSSTRING(AllMembers, SelectedUser), 

    1, 0
)
