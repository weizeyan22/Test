User_WorkItemOwnership = 
UNION(
    // 1. Ajouter les workitems des utilisateurs individuels
    SELECTCOLUMNS('BR',
        "User", 'BR'[Latest Workitem Owner],
        "Role", 'BR'[Role]
    ),

    // 2. Ajouter les workitems des membres des workgroups
    SELECTCOLUMNS('BR',
        "User", 'BR'[WorkItem Owner Member], 
        "Role", 'BR'[Role]
    )
)
