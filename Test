Step 1 = 
VAR LastCompletionDate = 
    CALCULATE(
        MAX('Table'[Completion Date]), 
        'Table'[Step] = "Step 1",
        'Table'[Operation] = SELECTEDVALUE('Table'[Operation])
    )

RETURN 
    LOOKUPVALUE(
        'Table'[Status], 
        'Table'[Step], "Step 1", 
        'Table'[Completion Date], LastCompletionDate,
        'Table'[Operation], SELECTEDVALUE('Table'[Operation])
    )
