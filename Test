Step 2 Status = 
VAR Step2Status = 
    CALCULATE(
        MAX('BR'[Status]), 
        FILTER(
            'BR', 
            'BR'[Role] = EARLIER('BR'[Role]) &&
            'BR'[Step] = "Step 2"
        )
    )
VAR Step1Date = 
    CALCULATE(
        MAX('BR'[Completion Date]), 
        FILTER(
            'BR', 
            'BR'[Role] = EARLIER('BR'[Role]) &&
            'BR'[Step] = "Step 1"
        )
    )
VAR Step2Date = 
    CALCULATE(
        MAX('BR'[Completion Date]), 
        FILTER(
            'BR', 
            'BR'[Role] = EARLIER('BR'[Role]) &&
            'BR'[Step] = "Step 2"
        )
    )
RETURN 
    IF(Step1Date > Step2Date, BLANK(), Step2Status)
