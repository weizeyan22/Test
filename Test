
VAR LatestCompletionDate =
    MAXX(
        FILTER(
            'BR',
            'BR'[RoleDisplayName] = EARLIER('BR'[RoleDisplayName]) &&
            'BR'[ApplicationName] = EARLIER('BR'[ApplicationName]) &&
            'BR'[EntitlementName] = EARLIER('BR'[EntitlementName]) &&
            'BR'[Step2] = "1st Step - Business Role Owner"
        ),
        'BR'[ArchivedDate] // On cherche la Completion Date la plus récente
    )

VAR LatestDecision_Completion =
    LOOKUPVALUE(
        'BR'[Decision.1],
        'BR'[RoleDisplayName], EARLIER('BR'[RoleDisplayName]),
        'BR'[ApplicationName], EARLIER('BR'[ApplicationName]),
        'BR'[EntitlementName], EARLIER('BR'[EntitlementName]),
        'BR'[Step2], "1st Step - Business Role Owner",
        'BR'[ArchivedDate], LatestCompletionDate
    )

VAR LatestCreationDate =
    MAXX(
        FILTER(
            'BR',
            'BR'[RoleDisplayName] = EARLIER('BR'[RoleDisplayName]) &&
            'BR'[ApplicationName] = EARLIER('BR'[ApplicationName]) &&
            'BR'[EntitlementName] = EARLIER('BR'[EntitlementName]) &&
            'BR'[Step2] = "1st Step - Business Role Owner" &&
            ISBLANK('BR'[ArchivedDate]) // On prend les cases où Completion Date est vide
        ),
        'BR'[CreationDate] // Prend la Création Date la plus récente si Completion Date est vide
    )

VAR LatestDecision_Creation =
    LOOKUPVALUE(
        'BR'[Decision.1],
        'BR'[RoleDisplayName], EARLIER('BR'[RoleDisplayName]),
        'BR'[ApplicationName], EARLIER('BR'[ApplicationName]),
        'BR'[EntitlementName], EARLIER('BR'[EntitlementName]),
        'BR'[Step2], "1st Step - Business Role Owner",
        'BR'[CreationDate], LatestCreationDate
    )

RETURN
    IF(
        ISBLANK(LatestCompletionDate),
        LatestDecision_Creation, // Si Completion Date est vide, on prend la décision avec Création Date la plus récente
        LatestDecision_Completion // Sinon, on prend la décision avec la Completion Date la plus récente
    )
