Criticality = 
VAR CountITRolePerMyIAM = 
    CALCULATE(
        DISTINCTCOUNT('VotreTable'[IT Role]), 
        ALLEXCEPT('VotreTable', 'VotreTable'[MyIAM ent])
    )

VAR CountGroupPerMyIAM = 
    CALCULATE(
        DISTINCTCOUNT('VotreTable'[Group]), 
        ALLEXCEPT('VotreTable', 'VotreTable'[MyIAM ent])
    )

VAR CountMyIAMPerITRole = 
    CALCULATE(
        DISTINCTCOUNT('VotreTable'[MyIAM ent]), 
        ALLEXCEPT('VotreTable', 'VotreTable'[IT Role])
    )

RETURN 
    IF(CountGroupPerMyIAM = 1 && CountMyIAMPerITRole = 1, "1-1",
        IF(CountGroupPerMyIAM > 1, "1-N",
            IF(CountMyIAMPerITRole > 1, "N-1",
                "Autre Cas"
            )
        )
    )
