VAR LatestCompletionDate =
    CALCULATE(
        MAX('BR'[CompletionDate]),
        FILTER(
            'BR',
            'BR'[RoleDisplayName] = EARLIER('BR'[RoleDisplayName]) &&
            'BR'[ApplicationName] = EARLIER('BR'[ApplicationName]) &&
            'BR'[EntitlementName] = EARLIER('BR'[EntitlementName]) &&
            'BR'[Step2] = "1st Step - Business Role Owner" &&
            NOT(ISBLANK('BR'[CompletionDate]))  // On ne prend que les dates non vides
        )
    )

VAR HasBlankCompletion =
    CALCULATE(
        COUNTROWS('BR'),
        FILTER(
            'BR',
            'BR'[RoleDisplayName] = EARLIER('BR'[RoleDisplayName]) &&
            'BR'[ApplicationName] = EARLIER('BR'[ApplicationName]) &&
            'BR'[EntitlementName] = EARLIER('BR'[EntitlementName]) &&
            'BR'[Step2] = "1st Step - Business Role Owner" &&
            ISBLANK('BR'[CompletionDate])  // Vérifie s'il existe au moins une CompletionDate vide
        )
    ) > 0

VAR LatestCreationDate =
    IF(
        HasBlankCompletion,
        CALCULATE(
            MAX('BR'[CreationDate]),
            FILTER(
                'BR',
                'BR'[RoleDisplayName] = EARLIER('BR'[RoleDisplayName]) &&
                'BR'[ApplicationName] = EARLIER('BR'[ApplicationName]) &&
                'BR'[EntitlementName] = EARLIER('BR'[EntitlementName]) &&
                'BR'[Step2] = "1st Step - Business Role Owner" &&
                ISBLANK('BR'[CompletionDate])  // On ne prend que ceux avec CompletionDate vide
            )
        ),
        BLANK()
    )

RETURN 
    CALCULATE(
        MAX('BR'[Decision.1]), 
        FILTER(
            'BR',
            'BR'[RoleDisplayName] = EARLIER('BR'[RoleDisplayName]) &&
            'BR'[ApplicationName] = EARLIER('BR'[ApplicationName]) &&
            'BR'[EntitlementName] = EARLIER('BR'[EntitlementName]) &&
            'BR'[Step2] = "1st Step - Business Role Owner" &&
            (
                (NOT(ISBLANK('BR'[CompletionDate])) && 'BR'[CompletionDate] = LatestCompletionDate) ||
                (ISBLANK('BR'[CompletionDate]) && 'BR'[CreationDate] = LatestCreationDate)
            )
        )
    )
