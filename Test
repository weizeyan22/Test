Filtrage Dynamique = 
VAR SelectedUser = SELECTEDVALUE('WorkItem Owner Members'[Filtre]) 

RETURN
IF(
    NOT(ISBLANK(SelectedUser)) &&
    (
        -- Cas 1 : L'utilisateur est le Latest WorkItem Owner
        SELECTEDVALUE('BR'[Latest WorkItem Owner]) = SelectedUser

        -- Cas 2 : L'utilisateur fait partie d'un groupe qui est Latest WorkItem Owner
        || SEARCH(SelectedUser, CONCATENATEX(VALUES('BR'[WorkItem Owner Members]), 'BR'[WorkItem Owner Members], ", "), 1, 0) > 0
    ), 
    1, 
    0
)
