IsLatestDateMeasure = 
VAR LatestCreationDate =
    CALCULATE(
        MAX('BR'[Creation Date]),
        ALLEXCEPT('BR', 'BR'[Role], 'BR'[Application], 'BR'[Entitlement], 'BR'[Operation], 'BR'[Action])
    )

VAR LatestCompletionDate =
    CALCULATE(
        MAX('BR'[Completion Date]),
        ALLEXCEPT('BR', 'BR'[Role], 'BR'[Application], 'BR'[Entitlement], 'BR'[Operation], 'BR'[Action]),
        'BR'[Creation Date] = LatestCreationDate
    )

RETURN 
IF(SELECTEDVALUE('BR'[Completion Date]) = LatestCompletionDate, "Yes", "No")
