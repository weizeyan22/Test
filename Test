FiltreWorkItems = 
VAR UserID = SELECTEDVALUE('Users'[UserID])  -- Utilisation d'un slicer pour sélectionner l'utilisateur
VAR IsMember = 
    CALCULATE(
        COUNTROWS('WorkItem Owner Members'),
        CONTAINSSTRING('WorkItem Owner Members'[WorkItem Owner Members], UserID)
    )
VAR IsOwner = 
    CALCULATE(
        COUNTROWS('WorkItem Owner Members'),
        'WorkItem Owner Members'[WorkItem Owner] = UserID
    )
RETURN
    IF(IsOwner > 0 || IsMember > 0, 1, 0)
