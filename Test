Entitlement Status = 
VAR Step1_Status = 'Table'[Step 1]
VAR Step2_Status = 'Table'[Step 2]
VAR Step3_Status = 'Table'[Step 3]
VAR Operation_Type = 'Table'[operation]

RETURN 
    SWITCH(TRUE(),
        -- Si Step 3 est "Approved" et l'opération est "add"
        Step3_Status = "Approved" && Operation_Type = "add", "Added to role",
        
        -- Si Step 3 est "Approved" et l'opération est "remove"
        Step3_Status = "Approved" && Operation_Type = "remove", "Removed from role",
        
        -- Si Step 3 est "Denied"
        Step3_Status = "Denied", "Rejected by Step 3",

        -- Si Step 3 est "Undecided"
        Step3_Status = "Undecided", "Pending at Step 3",

        -- Si Step 2 est "Denied"
        Step2_Status = "Denied", "Rejected by Step 2",

        -- Si Step 2 est "Undecided"
        Step2_Status = "Undecided", "Pending at Step 2",

        -- Si Step 1 est "Denied"
        Step1_Status = "Denied", "Rejected by Step 1",

        -- Si Step 1 est "Undecided"
        Step1_Status = "Undecided", "Pending at Step 1",

        -- Si Step 1 est "Approved" et Step 2 & 3 sont vides
        Step1_Status = "Approved" && ISBLANK(Step2_Status) && ISBLANK(Step3_Status), "Pending for Step 2",

        -- Si Step 1 & 2 sont "Approved" et Step 3 est vide
        Step1_Status = "Approved" && Step2_Status = "Approved" && ISBLANK(Step3_Status), "Pending for Step 3",

        -- Si aucun des cas précédents ne s'applique
        "Unknown"
    )
==================================================================

Entitlement Status = 
VAR Operation_Type = SELECTEDVALUE('Table'[Operation])
VAR Step1_Status = 
    CALCULATE(
        MAX('Table'[Status]),
        'Table'[Step] = "Step 1",
        'Table'[Operation] = Operation_Type
    )
VAR Step2_Status = 
    CALCULATE(
        MAX('Table'[Status]),
        'Table'[Step] = "Step 2",
        'Table'[Operation] = Operation_Type
    )
VAR Step3_Status = 
    CALCULATE(
        MAX('Table'[Status]),
        'Table'[Step] = "Step 3",
        'Table'[Operation] = Operation_Type
    )

RETURN 
    SWITCH(TRUE(),
        -- Rejet à Step 3
        Step3_Status = "Denied", "Rejected by Step 3",

        -- Rejet à Step 2
        Step2_Status = "Denied", "Rejected by Step 2",

        -- Rejet à Step 1
        Step1_Status = "Denied", "Rejected by Step 1",

        -- Tout est approuvé et l'opération est "Add"
        Step3_Status = "Approved" && Operation_Type = "Add", "Added to role",

        -- Tout est approuvé et l'opération est "Remove"
        Step3_Status = "Approved" && Operation_Type = "Remove", "Removed from role",

        -- Step 1 & 2 Approved mais Step 3 vide
        Step1_Status = "Approved" && Step2_Status = "Approved" && ISBLANK(Step3_Status), "Pending for Step 3",

        -- Step 1 Approved mais Step 2 & 3 vides
        Step1_Status = "Approved" && ISBLANK(Step2_Status) && ISBLANK(Step3_Status), "Pending for Step 2",

        -- Sinon
        "Unknown"
    )
