Is Latest WorkItem =
VAR MaxCompletionDate =
    CALCULATE(
        MAX('Table'[Completion Date]),
        ALLEXCEPT('Table', 'Table'[WorkItem Owner])
    )
RETURN IF('Table'[Completion Date] = MaxCompletionDate, 1, 0)


Latest WorkItem Owner Members =
VAR FilteredTable =
    FILTER(
        'Table',
        'Table'[Is Latest WorkItem] = 1
    )
RETURN
    CONCATENATEX(FilteredTable, 'Table'[WorkItem Owner Members], UNICHAR(10))
