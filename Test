Cardinality = 
VAR CountGroupsPerEntitlement = 
    CALCULATE(
        DISTINCTCOUNT('VotreTable'[Group]), 
        ALLEXCEPT('VotreTable', 'VotreTable'[MyIAM ent], 'VotreTable'[IT Role])
    )

VAR CountEntitlementsPerITRole = 
    CALCULATE(
        DISTINCTCOUNT('VotreTable'[MyIAM ent]), 
        ALLEXCEPT('VotreTable', 'VotreTable'[IT Role], 'VotreTable'[Group])
    )

VAR CheckSingleGroupPerEntitlement = 
    CALCULATE(
        COUNTROWS('VotreTable'),
        ALLEXCEPT('VotreTable', 'VotreTable'[MyIAM ent], 'VotreTable'[Group])
    ) = 1

RETURN 
    IF(CountGroupsPerEntitlement = 1 && CheckSingleGroupPerEntitlement, "1-1",
        IF(CountGroupsPerEntitlement > 1, "1-N",
            IF(CountEntitlementsPerITRole > 1, "N-1",
                "Autre Cas"
            )
        )
    )
