
VAR LatestNonBlankCompletionDate =
    CALCULATE(
        MAX('BR'[CompletionDate]),
        'BR'[RoleDisplayName] = EARLIER('BR'[RoleDisplayName]) &&
        'BR'[ApplicationName] = EARLIER('BR'[ApplicationName]) &&
        'BR'[EntitlementName] = EARLIER('BR'[EntitlementName]) &&
        'BR'[Step2] = "1st Step - Business Role Owner" &&
        NOT(ISBLANK('BR'[CompletionDate])) // Exclut les valeurs vides
    )

VAR LatestCreationDate =
    CALCULATE(
        MAX('BR'[CreationDate]),
        'BR'[RoleDisplayName] = EARLIER('BR'[RoleDisplayName]) &&
        'BR'[ApplicationName] = EARLIER('BR'[ApplicationName]) &&
        'BR'[EntitlementName] = EARLIER('BR'[EntitlementName]) &&
        'BR'[Step2] = "1st Step - Business Role Owner" &&
        ISBLANK('BR'[CompletionDate]) // Ne prend que les CompletionDate vides
    )

VAR HasBlankCompletion =
    CALCULATE(
        COUNTROWS('BR'),
        'BR'[RoleDisplayName] = EARLIER('BR'[RoleDisplayName]) &&
        'BR'[ApplicationName] = EARLIER('BR'[ApplicationName]) &&
        'BR'[EntitlementName] = EARLIER('BR'[EntitlementName]) &&
        'BR'[Step2] = "1st Step - Business Role Owner" &&
        ISBLANK('BR'[CompletionDate])
    ) > 0

RETURN 
    CALCULATE(
        SELECTEDVALUE('BR'[Decision.1]), 
        FILTER(
            'BR',
            'BR'[RoleDisplayName] = EARLIER('BR'[RoleDisplayName]) &&
            'BR'[ApplicationName] = EARLIER('BR'[ApplicationName]) &&
            'BR'[EntitlementName] = EARLIER('BR'[EntitlementName]) &&
            'BR'[Step2] = "1st Step - Business Role Owner" &&
            (
                (NOT(ISBLANK('BR'[CompletionDate])) && 'BR'[CompletionDate] = LatestNonBlankCompletionDate) ||
                (HasBlankCompletion && 'BR'[CreationDate] = LatestCreationDate)
            )
        )
    )
