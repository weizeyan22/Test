IsWorkItemVisible = 
VAR SelectedUser = SELECTEDVALUE('Users'[UserName]) // Récupère l’utilisateur sélectionné
VAR WorkItemOwner = 'BR'[Latest Workitem Owner] // Dernier propriétaire du workitem
VAR AllMembers = 'BR'[All Members] // Membres du workgroup concaténés

RETURN
IF(
    WorkItemOwner = SelectedUser || CONTAINSSTRING(AllMembers, SelectedUser),
    1, 
    0
)
